# Copy this file to .env and fill in your own values:
#   cp env.example .env
# Never commit the .env file. It is listed in .gitignore.

# Your Google Cloud project ID and the bucket to store pipeline data in
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=your-bucket-name

# Choose ONE way for the agents to reach Gemini.

# Option A (default): Gemini through Vertex AI, billed to the project above.
# Requires the Vertex AI API: gcloud services enable aiplatform.googleapis.com
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global

# Option B: a Gemini API key from https://aistudio.google.com/apikey
# To use it, set GOOGLE_GENAI_USE_VERTEXAI=FALSE above and fill in the key.
# GOOGLE_API_KEY=paste-your-key-here

# Optional: change the Gemini model the agents use
# PIPELINE_MODEL=gemini-3.5-flash
